# Backend API URL (no trailing slash required — /api is appended automatically)
# Local dev with Vite proxy: leave unset or use /api
# Production (Render): https://your-backend.onrender.com
VITE_API_URL=

# Optional: override Vite dev proxy target (default http://localhost:10000)
# VITE_DEV_PROXY=http://localhost:10000
