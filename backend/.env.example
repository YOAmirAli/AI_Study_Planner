# Flask
FLASK_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

# CORS — comma-separated frontend URLs in production (use * only for local dev)
CORS_ORIGINS=*

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=study_planner

# OpenAI — quiz, summary, tutor (required for those features)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# YouTube Data API v3 — optional; falls back to youtube-search-python
YOUTUBE_API_KEY=

# Optional (not used by default hybrid routing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
